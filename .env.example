DISCORD_TOKEN=... # bot token
GUILD_ID=123... # server id
CATEGORY_ID=456... # category holding the timed channels
LOBBY_CHANNEL_ID=789... #optional; always-visible channel, topic shows next opening
OPEN_TIME=21:00 # local opening time, HH:MM
OPEN_MINUTES=60 # window length
TIMEZONE=Europe/London # IANA zone; DST handled correctly
MODE=hide # "hide" (channels disappear) or "lock" (read-only)
